{
  "output_root": ".evidence",
  "renderer": {
    "engine": "pillow-pygments",
    "format": "png",
    "font": ["Consolas", "DejaVu Sans Mono", "Courier New"],
    "font_size": 15,
    "max_lines": 80,
    "theme": "dark"
  },
  "capture": {
    "bash": true,
    "mcp": true,
    "screenshots": true
  },
  "allowed_mcp_servers": [
    "playwright*",
    "windows-*",
    "hexstrike*"
  ],
  "map": {
    "regenerate_on_capture": true,
    "screenshots_section": true
  },
  "image_producing_tools": {
    "browser_take_screenshot": "filepath",
    "Screenshot": "base64",
    "Snapshot": "base64"
  },
  "command_producing_mcp_tools": [
    "PowerShell"
  ],
  "sensitive_hint_tools": [
    "browser_network_request",
    "browser_network_requests",
    "browser_evaluate",
    "PowerShell",
    "execute_command",
    "execute_python_script",
    "Registry",
    "Clipboard"
  ],
  "integrity": {
    "hash_chain": true,
    "sign_manifest": false
  }
}
