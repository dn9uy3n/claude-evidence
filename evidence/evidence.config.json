{
  "output_root": ".evidence",
  "renderer": {
    "engine": "pillow-pygments",
    "format": "png",
    "font": ["Consolas", "DejaVu Sans Mono", "Courier New"],
    "font_size": 15,
    "max_lines": 80,
    "theme": "dark"
  },
  "capture": {
    "bash": true,
    "mcp": true,
    "screenshots": true
  },
  "map": {
    "regenerate_on_capture": true,
    "screenshots_section": true
  },
  "image_producing_tools": {
    "mcp__playwright__browser_take_screenshot": "filepath",
    "mcp__windows-mcp__Screenshot": "base64",
    "mcp__windows-mcp__Snapshot": "base64",
    "mcp__hexstrike-ai__*_screenshot": "auto"
  },
  "command_producing_mcp_tools": [
    "mcp__windows-mcp__PowerShell"
  ],
  "hexstrike_structured_tools": [
    "nmap_scan",
    "nuclei_scan",
    "sqlmap_scan",
    "ffuf_scan",
    "gobuster_scan"
  ],
  "integrity": {
    "hash_chain": true,
    "sign_manifest": false
  }
}
